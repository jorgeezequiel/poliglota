.env
.env.*
!.env.example
!.env.template

# Chaves e certificados privados
*.pem
*.key
*.p12
*.pfx
*.keystore

# ----------------------------
# Logs e arquivos temporários
# ----------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej

# ----------------------------
# Configurações locais
# ----------------------------
*.local
*.local.*
config.local.*
settings.local.*

# ----------------------------
# Modelos e recursos offline
# ----------------------------
# Modelos de tradução podem ocupar muitos GB.
# Distribua instruções de instalação e download,
# não os modelos pesados no Git.
#
# Ignoramos diretórios dedicados a modelos e extensões que são,
# na prática, sempre artefatos de modelo. NÃO ignoramos extensões
# genéricas como .bin/.json/.txt: elas podem ser código,
# documentação, fixtures ou testes legítimos do projeto.
models/
model_cache/
model-cache/
checkpoints/
weights/
*.onnx
*.gguf
*.safetensors
*.pt
*.pth

# Cache de bibliotecas e downloads
.cache/
.cache-*/
huggingface_cache/
transformers_cache/
downloads/
download_cache/

# ----------------------------
# Resultados e relatórios locais
# ----------------------------
reports/
results/
output/
outputs/
artifacts/
*.report.json
*.report.csv

# ----------------------------
# Arquivos de tradução temporários
# ----------------------------
# Não ignore *.arb ou *.xml globalmente.
# Arquivos de exemplo e fixtures devem ser públicos.

*.arb.tmp
*.arb.bak
*.xml.tmp
*.xml.bak

# ----------------------------
# Bancos de dados locais
# ----------------------------
*.sqlite
*.sqlite3
*.db

# ----------------------------
# Sistema operacional
# ----------------------------
.DS_Store
._*
.Spotlight-V100/
.Trashes/
ehthumbs.db
Desktop.ini

# ----------------------------
# Git: arquivos locais auxiliares
# ----------------------------
*.patch
*.stackdump

# Relatórios internos de planejamento e auditoria
/reports/
