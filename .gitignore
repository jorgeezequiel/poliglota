# Python: ambientes virtuais
# ----------------------------
.venv/
venv/
env/
ENV/

# ----------------------------
# Python: caches e bytecode
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.tox/
.nox/
.hypothesis/

