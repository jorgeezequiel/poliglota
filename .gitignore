# ----------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
junit.xml
test-results/
.pyre/

# ----------------------------
# IDEs e editores
# ----------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# Ferramentas locais de desenvolvimento
/.codegraph/
/.omo/

# Cache de testes Python
/.pytest_cache/

# Relatórios internos das auditorias iniciais
/PHASE_1_PLANNING_REPORT.md
/PHASE_2_AUDIT_REPORT.md
/PHASE_2_COMPARATIVE_REPORT.md


# ----------------------------
# Variáveis de ambiente e segredos
